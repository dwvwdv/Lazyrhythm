<form [formGroup]="contactForm" (ngSubmit)="onSubmit()" class="contact-form">
  <h2>{{ formType === 'contact' ? 'Contact Form' : 'Support Form' }}</h2>

  <div class="form-group">
    <label for="name">Name</label>
    <input id="name" type="text" formControlName="name" placeholder="Your name">
  </div>

  <div class="form-group">
    <label for="email">Email</label>
    <input id="email" type="email" formControlName="email" placeholder="your@email.com">
  </div>

  <div class="form-group">
    <label for="subject">Subject</label>
    <input id="subject" type="text" formControlName="subject" placeholder="What is this about?">
  </div>

  <div class="form-group" *ngIf="formType === 'sponsor'">
    <label for="amount">Amount</label>
    <input id="amount" type="number" formControlName="amount" placeholder="Enter amount">
  </div>

  <div class="form-group">
    <label for="message">Message</label>
    <textarea id="message" formControlName="message" rows="5" placeholder="Your message here..."></textarea>
  </div>

  <p *ngIf="submitted">Message sent successfully.</p>
  <p *ngIf="submitError">Unable to send the message. Please try again.</p>

  <button type="submit" class="btn btn-primary" [disabled]="isSubmitting">
    {{ isSubmitting ? 'Sending...' : (formType === 'contact' ? 'Send Message' : 'Confirm Support') }}
  </button>
</form>
